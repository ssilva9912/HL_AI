HOMELAB_API_HOST=127.0.0.1
HOMELAB_API_PORT=8000
HOMELAB_API_URL=http://127.0.0.1:8000
HOMELAB_FRONTEND_PORT=8501
# Reverse proxy (Caddy) entry point. Bound to all interfaces so it's reachable from your LAN.
HOMELAB_PROXY_PORT=80

HOMELAB_OLLAMA_URL=http://localhost:11434
HOMELAB_OLLAMA_URL_DOCKER=http://host.docker.internal:11434
HOMELAB_LLM_MODEL=llama3.1:8b
HOMELAB_EMBEDDING_MODEL=nomic-embed-text

# Performance and observability
HOMELAB_OLLAMA_KEEP_ALIVE=30m
# Maximum tokens per answer; stops a model that fails to stop from running for minutes.
HOMELAB_OLLAMA_NUM_PREDICT=1024
HOMELAB_WARMUP_ON_STARTUP=true
HOMELAB_QUERY_CACHE_SIZE=256
HOMELAB_QUERY_CACHE_TTL_SECONDS=900
# "json" emits one structured JSON object per log line.
HOMELAB_LOG_FORMAT=text
HOMELAB_METRICS_ENABLED=true
# Web search (opt-in per question): docker compose --profile web up -d
# Leave unset in Docker to use the bundled SearXNG; set it empty to disable web search.
# HOMELAB_WEB_SEARCH_URL=http://searxng:8080
HOMELAB_WEB_MAX_RESULTS=4
# Corrective RAG: grade retrieved passages, trim them to the relevant sentences, and use the
# web only when the documents do not cover the question (and web search is allowed for it).
# Thresholds are cross-encoder scores: >= correct means the documents answer it, <= incorrect
# means they do not, and anything between uses both.
HOMELAB_CRAG_ENABLED=true
HOMELAB_CRAG_CORRECT_THRESHOLD=2.0
HOMELAB_CRAG_INCORRECT_THRESHOLD=-6.0
HOMELAB_CRAG_STRIP_THRESHOLD=-4.0
HOMELAB_CRAG_QUERY_REWRITE=true
HOMELAB_SEARXNG_PORT=8888
SEARXNG_SECRET=replace_with_a_random_local_secret
# Only used by: docker compose --profile observability up -d
# Prometheus and Grafana bind to localhost. Change the default Grafana admin password.
HOMELAB_PROMETHEUS_PORT=9090
HOMELAB_GRAFANA_PORT=3001
# Address your browser uses for the app's Metrics tab (change it if Grafana is behind a proxy).
# HOMELAB_GRAFANA_URL=http://localhost:3001
GRAFANA_ADMIN_PASSWORD=replace_with_a_random_local_password

HOMELAB_REQUEST_TIMEOUT=120
HOMELAB_EMBEDDING_TIMEOUT=30
HOMELAB_DEFAULT_TOP_K=5
HOMELAB_CONVERSATION_MEMORY_MESSAGES=12
HOMELAB_CONVERSATION_MEMORY_CHARS=4000
HOMELAB_HYBRID_RELEVANCE_THRESHOLD=0.0
HOMELAB_MAX_UPLOAD_BYTES=10485760

HOMELAB_DOCUMENT_DIRECTORY=data/documents
HOMELAB_STAGING_DIRECTORY=data/staging
HOMELAB_NETWORK_SHARE_NAME=Local document share
# Docker bind-mount source. Start with this local folder; replace it with a NAS path later.
HOMELAB_NETWORK_SHARE_HOST_PATH=./data/network-share
# Used only when running the API directly on the host instead of Docker.
HOMELAB_NETWORK_SHARE_DIRECTORY=data/network-share
HOMELAB_VECTOR_STORE_PATH=data/index/qdrant
HOMELAB_VECTOR_COLLECTION_NAME=homelab_documents

POSTGRES_DB=homelab_ai
POSTGRES_USER=homelab_ai
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=5432

HOMELAB_DATABASE_URL=postgresql+psycopg://homelab_ai:replace_with_a_random_local_password@localhost:5432/homelab_ai
HOMELAB_EMBEDDING_BATCH_SIZE=32
HOMELAB_DOCUMENT_CHUNK_SIZE=1200
HOMELAB_DOCUMENT_CHUNK_OVERLAP=120
HOMELAB_DATABASE_ECHO=false
