HOMELAB_API_HOST=127.0.0.1
HOMELAB_API_PORT=8000
HOMELAB_API_URL=http://127.0.0.1:8000
HOMELAB_FRONTEND_PORT=8501

HOMELAB_OLLAMA_URL=http://localhost:11434
HOMELAB_OLLAMA_URL_DOCKER=http://host.docker.internal:11434
HOMELAB_LLM_MODEL=llama3.1:8b
HOMELAB_EMBEDDING_MODEL=nomic-embed-text

HOMELAB_REQUEST_TIMEOUT=120
HOMELAB_EMBEDDING_TIMEOUT=30
HOMELAB_DEFAULT_TOP_K=5
HOMELAB_CONVERSATION_MEMORY_MESSAGES=12
HOMELAB_CONVERSATION_MEMORY_CHARS=4000
HOMELAB_HYBRID_RELEVANCE_THRESHOLD=0.0
HOMELAB_MAX_UPLOAD_BYTES=10485760

HOMELAB_DOCUMENT_DIRECTORY=data/documents
HOMELAB_STAGING_DIRECTORY=data/staging
HOMELAB_NETWORK_SHARE_NAME=Local document share
# Docker bind-mount source. Start with this local folder; replace it with a NAS path later.
HOMELAB_NETWORK_SHARE_HOST_PATH=./data/network-share
# Used only when running the API directly on the host instead of Docker.
HOMELAB_NETWORK_SHARE_DIRECTORY=data/network-share
HOMELAB_VECTOR_STORE_PATH=data/index/qdrant
HOMELAB_VECTOR_COLLECTION_NAME=homelab_documents

POSTGRES_DB=homelab_ai
POSTGRES_USER=homelab_ai
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=5432

HOMELAB_DATABASE_URL=postgresql+psycopg://homelab_ai:replace_with_a_random_local_password@localhost:5432/homelab_ai
HOMELAB_EMBEDDING_BATCH_SIZE=32
HOMELAB_DOCUMENT_CHUNK_SIZE=1200
HOMELAB_DOCUMENT_CHUNK_OVERLAP=120
HOMELAB_DATABASE_ECHO=false
